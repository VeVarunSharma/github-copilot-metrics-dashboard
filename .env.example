# --- GitHub Copilot Metrics Dashboard ---
# Copy to .env and fill in. Values here are loaded by both the collector and the web app.

# === GitHub authentication ===
# Classic PAT recommended. The token MUST be issued by an org owner / billing manager.
# Fine-grained PATs are NOT supported by the Billing endpoints.
# Required scopes by target:
#   Org scope (GITHUB_ORGS):
#     - read:org                    (required for metrics)
#     - manage_billing:copilot      (required for billing + AI credits)
#     - repo or public_repo         (required only when delivery ingestion is enabled)
#   Enterprise scope preview (GITHUB_ENTERPRISE):
#     - read:enterprise OR manage_billing:copilot   (required for metrics)
#     - manage_billing:copilot                       (required for billing + AI credits)
GITHUB_TOKEN=ghp_replace_me

# Comma-separated list of organization slugs to ingest. Optional if GITHUB_ENTERPRISE is set.
GITHUB_ORGS=

# Single enterprise slug to ingest for preview validation. Optional if GITHUB_ORGS is set.
# At least one of GITHUB_ORGS or GITHUB_ENTERPRISE must be set, but P0 readiness is org-scope
# unless release notes explicitly promote enterprise endpoint behavior.
GITHUB_ENTERPRISE=

# Phase 1 delivery ingestion (releases, workflow runs, commits) is OFF by default.
# Enable with this env var or pass --with-delivery to the collector. Requires repo or public_repo scope.
GITHUB_INGEST_DELIVERY=false

# Override GitHub API base URL (use for GitHub Enterprise Server: https://github.example.com/api/v3).
# Leave commented to use GitHub.com (Cloud).
# GITHUB_API_BASE_URL=https://api.github.com

# === Database ===
# Local default points at the docker-compose Postgres container.
DATABASE_URL=postgres://ghcp:ghcp@localhost:5432/ghcp_metrics

# === Web app ===
# Public base URL of the web app (used for ts-rest client + redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Inbound dashboard auth mode:
#   unset              Backward-compatible default: shared-password when
#                      DASHBOARD_PASSWORD is set, otherwise open.
#   open               No dashboard auth. Use only for local demos or when a
#                      trusted layer blocks all untrusted traffic. Settings
#                      mutations are rejected because there is no app identity.
#   shared-password    Beta fallback. Requires DASHBOARD_PASSWORD and protects
#                      dashboard pages/application APIs with a signed,
#                      httpOnly, sameSite=lax cookie.
#   identity-header    Trust a single header injected by Azure Easy Auth,
#                      Entra-protected ingress, or another identity-aware proxy.
#                      Do not use unless upstream strips spoofed client headers
#                      and enforces user/group access before traffic reaches
#                      the app. Native OAuth/RBAC is not implemented.
AUTH_MODE=

# Trusted identity header for AUTH_MODE=identity-header.
AUTH_IDENTITY_HEADER=x-ms-client-principal-name

# Beta shared-password fallback. Required for AUTH_MODE=shared-password and
# optional defense-in-depth fallback for AUTH_MODE=identity-header. Rotate by
# changing this value and restarting. See docs/auth.md before exposing the
# dashboard outside a local/private environment.
DASHBOARD_PASSWORD=

# For Azure production auth, enable Microsoft Entra built-in auth via azd/Bicep
# (ENABLE_ENTRA_AUTH=true, ENTRA_CLIENT_ID, ENTRA_CLIENT_SECRET). The web app then
# runs AUTH_MODE=identity-header automatically. See docs/auth.md.

# === Value translation defaults (overridable in Settings UI) ===
VALUE_AVG_LOADED_COST_PER_HOUR=100
VALUE_MIN_PER_ACCEPTED_COMPLETION=0.75
VALUE_MIN_PER_CHAT_REQUEST=2
VALUE_MIN_PER_AGENT_SESSION=30
VALUE_MIN_PER_COPILOT_AUTHORED_PR=60
VALUE_MIN_PER_COPILOT_REVIEWED_PR=15
VALUE_LOC_PER_HOUR_BASELINE=30

# === Phase 2 (not yet wired) ===
# AZURE_FABRIC_WORKSPACE_ID=
# AZURE_ADLS_CONNECTION_STRING=
