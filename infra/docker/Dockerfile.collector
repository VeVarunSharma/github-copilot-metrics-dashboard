# syntax=docker/dockerfile:1

FROM node:20-alpine AS deps
WORKDIR /app
ARG NPM_REGISTRY=https://registry.npmjs.org
ARG PNPM_VERSION=10.33.0
ENV npm_config_registry=$NPM_REGISTRY
RUN npm install --global "pnpm@${PNPM_VERSION}" --ignore-scripts --no-audit --no-fund

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/collector/package.json apps/collector/package.json
COPY packages packages
RUN pnpm install --frozen-lockfile

FROM deps AS build
WORKDIR /app
COPY . .
RUN pnpm --filter @ghcp-dash/contracts build \
  && pnpm --filter @ghcp-dash/value build \
  && pnpm --filter @ghcp-dash/db build \
  && pnpm --filter @ghcp-dash/collector build
RUN pnpm --filter @ghcp-dash/collector --prod deploy --legacy /app/collector-runtime

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build --chown=node:node /app/collector-runtime ./

USER node
CMD ["node", "dist/apps/collector/src/index.js"]
