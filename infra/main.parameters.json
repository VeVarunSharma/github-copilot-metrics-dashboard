{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "resourceGroupName": { "value": "rg-${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "namePrefix": { "value": "${NAME_PREFIX=ghcpdash}" },
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "webImage": { "value": "${SERVICE_WEB_IMAGE_NAME}" },
    "collectorImage": { "value": "${SERVICE_COLLECTOR_IMAGE_NAME}" },
    "migrationImage": { "value": "${SERVICE_COLLECTOR_IMAGE_NAME}" },
    "postgresAdminUsername": { "value": "${POSTGRES_ADMIN_USERNAME}" },
    "postgresAdminPassword": { "value": "${POSTGRES_ADMIN_PASSWORD}" },
    "webReadonlyPassword": { "value": "${WEB_READONLY_PASSWORD}" },
    "collectorWriterPassword": { "value": "${COLLECTOR_WRITER_PASSWORD}" },
    "migrationAdminPassword": { "value": "${MIGRATION_ADMIN_PASSWORD}" },
    "databaseName": { "value": "${DATABASE_NAME=ghcp_metrics}" },
    "postgresSkuName": { "value": "${POSTGRES_SKU_NAME=Standard_B1ms}" },
    "postgresSkuTier": { "value": "${POSTGRES_SKU_TIER=Burstable}" },
    "postgresStorageGb": { "value": "${POSTGRES_STORAGE_GB=32}" },
    "postgresBackupRetentionDays": { "value": "${POSTGRES_BACKUP_RETENTION_DAYS=7}" },
    "postgresGeoRedundantBackup": { "value": "${POSTGRES_GEO_REDUNDANT_BACKUP=Disabled}" },
    "webDatabaseUrl": { "value": "${WEB_DATABASE_URL=}" },
    "collectorDatabaseUrl": { "value": "${COLLECTOR_DATABASE_URL=}" },
    "migrationDatabaseUrl": { "value": "${MIGRATION_DATABASE_URL=}" },
    "useKeyVaultReferences": { "value": "${USE_KEY_VAULT_REFERENCES=true}" },
    "githubToken": { "value": "${GITHUB_TOKEN}" },
    "githubOrgs": { "value": "${GITHUB_ORGS=}" },
    "githubEnterprise": { "value": "${GITHUB_ENTERPRISE=}" },
    "githubApiBaseUrl": { "value": "${GITHUB_API_BASE_URL=https://api.github.com}" },
    "githubIngestDelivery": { "value": "${GITHUB_INGEST_DELIVERY=false}" },
    "dashboardPassword": { "value": "${DASHBOARD_PASSWORD}" },
    "authMode": { "value": "${AUTH_MODE=shared-password}" },
    "enableEntraAuth": { "value": "${ENABLE_ENTRA_AUTH=false}" },
    "entraClientId": { "value": "${ENTRA_CLIENT_ID=}" },
    "entraClientSecret": { "value": "${ENTRA_CLIENT_SECRET=}" },
    "authIdentityHeader": { "value": "${AUTH_IDENTITY_HEADER=x-ms-client-principal-name}" },
    "collectorCronExpression": { "value": "${COLLECTOR_CRON_EXPRESSION=0 4 * * *}" },
    "collectorConcurrency": { "value": "${COLLECTOR_CONCURRENCY=4}" },
    "collectorMaxRetries": { "value": "${COLLECTOR_MAX_RETRIES=5}" },
    "bronzeShareQuotaGb": { "value": "${BRONZE_SHARE_QUOTA_GB=100}" },
    "enableBronzeFileShareMount": { "value": "${ENABLE_BRONZE_FILE_SHARE_MOUNT=true}" },
    "collectorLogLevel": { "value": "${COLLECTOR_LOG_LEVEL=info}" },
    "enableAlerts": { "value": "${ENABLE_ALERTS=false}" },
    "alertEmailReceiver": { "value": "${ALERT_EMAIL_RECEIVER=}" },
    "alertWebhookReceiverUrl": { "value": "${ALERT_WEBHOOK_RECEIVER_URL=}" },
    "staleIngestionThresholdHours": { "value": "${STALE_INGESTION_THRESHOLD_HOURS=36}" },
    "enableAvailabilityTest": { "value": "${ENABLE_AVAILABILITY_TEST=false}" },
    "availabilityTestLocation": { "value": "${AVAILABILITY_TEST_LOCATION=us-va-ash-azr}" },
    "enableExportsLifecyclePolicy": { "value": "${ENABLE_EXPORTS_LIFECYCLE_POLICY=true}" },
    "exportsCoolAfterDays": { "value": "${EXPORTS_COOL_AFTER_DAYS=30}" },
    "exportsArchiveAfterDays": { "value": "${EXPORTS_ARCHIVE_AFTER_DAYS=90}" },
    "exportsDeleteAfterDays": { "value": "${EXPORTS_DELETE_AFTER_DAYS=365}" }
  }
}
